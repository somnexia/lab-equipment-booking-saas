extends layout

block content
  h1 Classes (PB)

  p Пользователь: #{user && user.email} (#{user && user.role})

  button#logoutBtn Выйти

  br
  a(href="/dashboard") ← Назад к оборудованию

  if error
    p(style="color:red")= error

  if classes && classes.length
    table(border="1")
      tr
        th Student
        th Subject
        th Grade
        th Status
      each cls in classes
        tr
          td= cls.student
          td= cls.subject
          td= cls.grade
          td= cls.status
  else
    p Нет данных

  h2 Добавить запись

  form#addForm
    input(type="text" name="student" placeholder="Student")
    input(type="text" name="subject" placeholder="Subject")
    input(type="number" name="grade" placeholder="Grade")
    input(type="text" name="status" placeholder="Status")
    button(type="submit") Добавить

    
  script(src="https://unpkg.com/pocketbase/dist/pocketbase.umd.js")

  script.
    const PB_URL = "#{process.env.PB_URL}";
    const pb = new PocketBase(PB_URL);

    console.log('Classes loaded');

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'include'
      });

      window.location.href = '/auth/login';
    });

    // REALTIME
    pb.collection('classes').subscribe('*', function (e) {
      console.log('🔥 REALTIME UPDATE:', e);
      location.reload();
    });

    const form = document.getElementById('addForm');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = {
        student: form.student.value,
        subject: form.subject.value,
        grade: Number(form.grade.value),
        status: form.status.value
      };

      const res = await fetch('/api/classes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        console.log('✅ Created');
        form.reset();
      } else {
        console.error('❌ Failed');
      }
    });