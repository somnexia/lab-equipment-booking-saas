extends layout

block content
  h1 Classes (PB)

  p Пользователь: #{user && user.email} (#{user && user.role})

  button#logoutBtn Выйти

  br
  a(href="/dashboard") ← Назад к оборудованию

  if error
    p(style="color:red")= error

  if classes && classes.length
    table(border="1")
      tr
        th Student
        th Subject
        th Grade
        th Status
      each cls in classes
        tr
          td= cls.student
          td= cls.subject
          td= cls.grade
          td= cls.status
  else
    p Нет данных

  script.
    const PB_URL = "#{process.env.PB_URL}";
    const pb = new PocketBase(PB_URL);
    console.log('Classes loaded');
    
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      console.log('🚪 Logout PB');

      await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'include'
      });

      window.location.href = '/auth/login';
    });
    console.log('📡 Subscribing to PB real-time...');

    const pb = new PocketBase("http://127.0.0.1:8090"); // или из env через window

    pb.collection('classes').subscribe('*', function (e) {
      console.log('🔥 REALTIME UPDATE:', e);

      // просто перезагружаем страницу (самый простой вариант)
      location.reload();
    });