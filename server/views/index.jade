extends layout

block content
  .hero
    h1 Lab Equipment Booking
    p SaaS для бронирования лабораторного оборудования: каталог приборов, слоты, роли пользователей.

    .hero-actions
      if user
        a.btn.btn-primary(href="/dashboard") Каталог оборудования
      else
        a.btn.btn-primary(href="/auth/login") Войти
        a.btn(href="/auth/register") Регистрация
