extends layout

block content
  .hero
    h1 Lab Equipment Booking
    p SaaS for booking laboratory equipment: equipment catalog, time slots, user roles.

    .hero-actions
      if user
        a.btn.btn-primary(href="/dashboard") Equipment catalog
      else
        a.btn.btn-primary(href="/auth/login") Log in
        a.btn(href="/auth/register") Register
