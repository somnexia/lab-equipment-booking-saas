extends layout

block content
  h1 Dashboard (Equipment)

  p Пользователь: #{user && user.email} (#{user && user.role})


  button#logout Выйти

  br
  a(href="/classes") Перейти к классам


  h2 Список оборудования

  table(border="1")
    thead
      tr
        th ID
        th Название
        th Категория
        th Статус
    tbody#equipmentTable

  script.
    console.log('Dashboard loaded');

    document.getElementById("logout").addEventListener("click", async () => {
      console.log('🚪 Logout mysql');

      await fetch('/api/auth/logout', {
        method: 'POST',
        credentials: 'include'
      });

      window.location.href = '/auth/login';
    });

    async function loadEquipment() {
      try {
        console.log('📡 Loading equipment');

        const response = await fetch("/api/equipment", {
          credentials: 'include'
        });

        if (response.status === 401) {
          console.log('❌ Unauthorized → redirect');
          window.location.href = '/auth/login';
          return;
        }

        const data = await response.json();
        console.log('Equipment:', data);

        const table = document.getElementById("equipmentTable");
        table.innerHTML = "";

        data.forEach(item => {
          const row = document.createElement("tr");

          row.innerHTML = `
            <td>${item.id}</td>
            <td>${item.name}</td>
            <td>${item.category_id}</td>
            <td>${item.status}</td>
          `;

          table.appendChild(row);
        });

      } catch (err) {
        console.error("Ошибка загрузки", err);
      }
    }

    loadEquipment();