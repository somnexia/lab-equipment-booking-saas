doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    - var docTitle = pageTitle || title
    title= docTitle ? docTitle + ' — Lab Booking' : 'Lab Equipment Booking'
    link(rel="stylesheet", href="/stylesheets/style.css")
  body
    header.site-header
      .header-inner
        a.brand(href="/")
          span.brand-title Lab Booking
          span.brand-sub SaaS · laboratory equipment

        if user
          nav.site-nav(aria-label="Main menu")
            if navPerms.showCatalog
              a.nav-link(href="/dashboard", class=currentPath.startsWith('/dashboard') ? 'is-active' : undefined) Catalog
            if navPerms.showBookings
              a.nav-link(href="/bookings", class=currentPath.startsWith('/bookings') && currentPath !== '/bookings/new' ? 'is-active' : undefined) My Bookings
            if navPerms.showNewBooking
              a.nav-link(href="/bookings/new", class=currentPath === '/bookings/new' ? 'is-active' : undefined) New Booking
            if navPerms.showAdmin
              a.nav-link(href="/admin", class=currentPath.startsWith('/admin') ? 'is-active' : undefined) Admin

          .header-user
            span.user-email= user.email
            if roleLabel
              span.user-role= roleLabel
            button#navLogout.btn.btn-ghost(type="button") Log out
        else
          nav.site-nav(aria-label="Sign in")
            a.nav-link(href="/auth/login", class=currentPath === '/auth/login' ? 'is-active' : undefined) Log in
            a.nav-link(href="/auth/register", class=currentPath === '/auth/register' ? 'is-active' : undefined) Register

    main.site-main
      .container
        block content

    footer.site-footer
      .container
        p Lab Equipment Booking · academic SaaS project

    block scripts

    if user
      script.
        (function () {
          const btn = document.getElementById('navLogout');
          if (!btn) return;
          btn.addEventListener('click', async function () {
            await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
            window.location.href = '/auth/login';
          });
        })();
