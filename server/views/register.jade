extends layout

block content
  h1 Регистрация

  form(id="registerForm")
    div
      label(for="name") Имя
      input(type="text" name="name" id="name" required)
    div
      label(for="email") Email
      input(type="email" name="email" id="email" required)
    div
      label(for="password") Пароль
      input(type="password" name="password" id="password" required)
    div
      label(for="organization_id") Organization ID
      input(type="number" name="organization_id" id="organization_id" required)
    button(type="submit") Зарегистрироваться

  p#message

block scripts
  script.
    const form = document.getElementById('registerForm');
    const message = document.getElementById('message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      console.log('Register clicked');

      const data = {
        name: form.name.value,
        email: form.email.value,
        password: form.password.value,
        organization_id: parseInt(form.organization_id.value),
        role: 'user'
      };

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        console.log('Register response', result);

        if (res.ok) {
          message.innerText = 'Регистрация успешна! Перенаправление...';
          setTimeout(() => {
            window.location.href = '/auth/login';
          }, 1500);
        } else {
          message.innerText = result.error || 'Ошибка регистрации';
        }
      } catch (err) {
        message.innerText = 'Ошибка соединения с сервером';
        console.error(err);
      }
    });