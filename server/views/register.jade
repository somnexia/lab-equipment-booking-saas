extends layout

block content
  .card.auth-card
    h1 Регистрация

    form#registerForm
      .form-row
        label Имя
        input(type="text", name="name", required)

      .form-row
        label Email
        input(type="email", name="email", required)

      .form-row
        label Пароль
        input(type="password", name="password", required)

      .form-row
        label Organization ID
        input(type="number", name="organization_id", value="1", required)
        small(style="color:#5c6b7a") Демо: 1 — химия, 2 — физика

      button.btn.btn-primary(type="submit") Зарегистрироваться

    p#message.form-message

block scripts
  script.
    const form = document.getElementById('registerForm');
    const message = document.getElementById('message');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      message.innerText = '';

      const data = {
        name: form.name.value,
        email: form.email.value,
        password: form.password.value,
        organization_id: parseInt(form.organization_id.value, 10),
        role: 'student'
      };

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });

        const result = await res.json();

        if (res.ok) {
          message.style.color = '#15803d';
          message.innerText = 'Регистрация успешна! Перенаправление…';
          setTimeout(function () {
            window.location.href = '/auth/login';
          }, 1000);
        } else {
          message.innerText = result.error || 'Ошибка регистрации';
        }
      } catch (err) {
        message.innerText = 'Ошибка соединения';
      }
    });
