extends layout

block content
  .card.auth-card
    h1 Register

    form#registerForm
      .form-row
        label(for="name") Name
        input#name(type="text", name="name", required)

      .form-row
        label(for="email") Email
        input#email(type="email", name="email", required)

      .form-row
        label(for="password") Password
        input#password(type="password", name="password", required, minlength="8")

      .form-row
        label(for="organization_id") Organization
        if organizations && organizations.length
          select#organization_id(name="organization_id", required)
            each org in organizations
              option(value=org.id)= org.name
        else
          select#organization_id(name="organization_id", disabled)
            option(value="") No organizations available
          p.page-hint Registration is temporarily unavailable — contact an administrator.

      button.btn.btn-primary(type="submit", disabled=!organizations || !organizations.length) Register

    p#message.form-message(role="alert", aria-live="polite", hidden)

    p.auth-footer
      | Already have an account?
      a(href="/auth/login") Log in

block scripts
  script.
    const form = document.getElementById('registerForm');
    const message = document.getElementById('message');
    const orgSelect = document.getElementById('organization_id');

    function showMessage(text, ok) {
      message.textContent = text || '';
      message.hidden = !text;
      message.style.color = ok ? '#15803d' : '#b91c1c';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      showMessage('');

      if (!orgSelect.value) {
        showMessage('Please select an organization');
        return;
      }

      const data = {
        name: form.name.value.trim(),
        email: form.email.value.trim(),
        password: form.password.value,
        organization_id: parseInt(orgSelect.value, 10),
        role: 'student',
      };

      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include',
        });

        const result = await res.json().catch(function () { return {}; });

        if (res.ok) {
          showMessage('Registration successful! Redirecting…', true);
          setTimeout(function () {
            window.location.href = '/auth/login';
          }, 1000);
        } else {
          showMessage(result.error || 'Registration failed');
        }
      } catch (err) {
        showMessage('Connection error');
      } finally {
        if (orgSelect.value) submitBtn.disabled = false;
      }
    });
