extends layout

block content
  h1 Регистрация

  form#registerForm
    div
      label Имя
      input(type="text", name="name", required)

    div
      label Email
      input(type="email", name="email", required)

    div
      label Пароль
      input(type="password", name="password", required)

    div
      label Organization ID
      input(type="number", name="organization_id", required)

    button(type="submit") Зарегистрироваться

  p#message

  script.
    const form = document.getElementById('registerForm');
    const message = document.getElementById('message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      console.log('🔥 Register submit');

      const data = {
        name: form.name.value,
        email: form.email.value,
        password: form.password.value,
        organization_id: parseInt(form.organization_id.value),
        role: "student"
      };

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });

        const result = await res.json();
        console.log('Register result:', result);

        if (res.ok) {
          message.innerText = "Регистрация успешна!";
          setTimeout(() => {
            window.location.href = "/auth/login";
          }, 1000);
        } else {
          message.innerText = result.error || "Ошибка регистрации";
        }

      } catch (err) {
        console.error(err);
        message.innerText = "Ошибка соединения";
      }
    });