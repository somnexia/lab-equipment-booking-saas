extends layout

block content
  h1.page-title= title
  p.page-lead
    if uiPerms.canCreate
      a(href="/bookings/new") + Новая бронь
      |  ·
    a(href="/dashboard") Каталог оборудования

  .bookings-toolbar
    label(for="statusFilter") Статус:
    select#statusFilter
      option(value="", selected=!uiPerms.defaultStatusFilter) Все
      option(value="active", selected=uiPerms.defaultStatusFilter === 'active') Активные
      option(value="completed") Завершённые
      option(value="cancelled") Отменённые
    button#btnReload.btn.btn-sm(type="button") Обновить

  if uiPerms.useOrgList
    p.page-hint Показаны брони вашей организации. По умолчанию — активные.

  table.data-table
    thead
      tr
        th ID
        th Оборудование
        if uiPerms.useOrgList
          th Пользователь
        th Начало
        th Конец
        th Статус
        th Действия
    tbody#bookingsTable
      tr
        td(colspan=uiPerms.useOrgList ? 7 : 6) Загрузка…

block scripts
  script.
    window.UI_PERMS = !{JSON.stringify(uiPerms)};

    const BOOKING_STATUS = {
      active: 'Активная',
      completed: 'Завершена',
      cancelled: 'Отменена',
    };

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text == null ? '' : String(text);
      return div.innerHTML;
    }

    function bookingsUrl() {
      const perms = window.UI_PERMS || {};
      const status = document.getElementById('statusFilter').value;
      const base = perms.useOrgList ? '/api/bookings' : '/api/bookings/me';
      if (!status) return base;
      return base + '?status=' + encodeURIComponent(status);
    }

    async function cancelBooking(id) {
      if (!confirm('Отменить бронь #' + id + '?')) return;
      const res = await fetch('/api/bookings/' + id + '/cancel', {
        method: 'PATCH',
        credentials: 'include',
      });
      const data = await res.json().catch(function () { return {}; });
      if (!res.ok) {
        alert(data.error || 'Ошибка отмены');
        return;
      }
      loadBookings();
    }

    async function completeBooking(id) {
      if (!confirm('Завершить бронь #' + id + '?')) return;
      const res = await fetch('/api/bookings/' + id + '/complete', {
        method: 'PATCH',
        credentials: 'include',
      });
      const data = await res.json().catch(function () { return {}; });
      if (!res.ok) {
        alert(data.error || 'Ошибка завершения');
        return;
      }
      loadBookings();
    }

    function buildActions(id, status) {
      const perms = window.UI_PERMS || {};
      if (status !== 'active') {
        return '<span class="muted">—</span>';
      }

      const parts = [];
      if (perms.canCancel) {
        parts.push('<button type="button" class="btn btn-sm btn-danger btn-cancel" data-id="' + id + '">Отменить</button>');
      }
      if (perms.canComplete) {
        parts.push('<button type="button" class="btn btn-sm btn-primary btn-complete" data-id="' + id + '">Завершить</button>');
      }

      if (!parts.length) {
        return '<span class="muted">—</span>';
      }
      return '<div class="row-actions">' + parts.join('') + '</div>';
    }

    async function loadBookings() {
      const table = document.getElementById('bookingsTable');
      const perms = window.UI_PERMS || {};
      const colSpan = perms.useOrgList ? 7 : 6;

      try {
        const res = await fetch(bookingsUrl(), { credentials: 'include' });
        if (res.status === 401) {
          window.location.href = '/auth/login';
          return;
        }
        if (!res.ok) {
          const err = await res.json().catch(function () { return {}; });
          table.innerHTML = '<tr><td colspan="' + colSpan + '">' + escapeHtml(err.error || 'Ошибка загрузки') + '</td></tr>';
          return;
        }

        const data = await res.json();
        table.innerHTML = '';

        if (!data.length) {
          table.innerHTML = '<tr><td colspan="' + colSpan + '">Нет бронирований</td></tr>';
          return;
        }

        data.forEach(function (b) {
          const id = b.booking_id ?? b.id;
          const status = b.booking_status ?? b.status;
          const row = document.createElement('tr');

          let html =
            '<td>' + escapeHtml(id) + '</td>' +
            '<td>' + escapeHtml(b.equipment_name || b.equipment_id) + '</td>';

          if (perms.useOrgList) {
            html += '<td>' + escapeHtml(b.user_name || b.user_email || b.user_id) + '</td>';
          }

          html +=
            '<td>' + escapeHtml(b.start_time) + '</td>' +
            '<td>' + escapeHtml(b.end_time) + '</td>' +
            '<td>' + escapeHtml(BOOKING_STATUS[status] || status) + '</td>' +
            '<td>' + buildActions(id, status) + '</td>';

          row.innerHTML = html;
          table.appendChild(row);
        });

        table.querySelectorAll('.btn-cancel').forEach(function (btn) {
          btn.addEventListener('click', function () {
            cancelBooking(btn.getAttribute('data-id'));
          });
        });

        table.querySelectorAll('.btn-complete').forEach(function (btn) {
          btn.addEventListener('click', function () {
            completeBooking(btn.getAttribute('data-id'));
          });
        });
      } catch (err) {
        console.error(err);
        table.innerHTML = '<tr><td colspan="' + colSpan + '">Ошибка загрузки</td></tr>';
      }
    }

    document.getElementById('statusFilter').addEventListener('change', loadBookings);
    document.getElementById('btnReload').addEventListener('click', loadBookings);
    loadBookings();
